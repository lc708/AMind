.DS_Store
__pycache__/
*.pyc
/.agents/
.obsidian/workspace*.json
.obsidian/cache/
work/
corpus/
tmp/
*.log

# The local evidence-building workspace is intentionally larger than the
# public v1 repository.  Keep only the final, inspectable pipeline surface;
# the self-contained data package lives under release/amind-v1/.
config/*
!config/amind-v1-atomic-claim.schema.json
!config/nuwa-v1-claim-audit-policy.json
!config/nuwa-v1-synthesis-policy.json
!config/nuwa-v1-evaluation-policy.json
!config/amind-v1-release-policy.json

scripts/*
!scripts/build_nuwa_v1_claim_audit.py
!scripts/test_build_nuwa_v1_claim_audit.py
!scripts/build_nuwa_v1_synthesis.py
!scripts/test_build_nuwa_v1_synthesis.py
!scripts/build_nuwa_v1_evaluation.py
!scripts/test_build_nuwa_v1_evaluation.py
!scripts/build_amind_v1_release.py
!scripts/test_build_amind_v1_release.py
!scripts/verify_amind_v1_release.py
!scripts/test_verify_amind_v1_release.py
!scripts/amind_v1.py
!scripts/test_amind_v1.py
!scripts/build_amind_skill.py
!scripts/build_amind_skill_index.py
!scripts/test_amind_skill.py
!scripts/run_amind_increment.py
!scripts/build_amind_increment.py
!scripts/verify_amind_increment.py
!scripts/test_amind_increment.py
!scripts/install_amind_series.py
!scripts/test_amind_app_skills.py
!scripts/test_amind_capability_kernel.py
!scripts/test_amind_behavior_regressions.py
!scripts/check_amind_capability_map.py
!scripts/benchmark_amind_runner.py
!scripts/verify_amind_application_skills.py

.eval-improve/
.codex-tmp/

/reports/

# Reproducible October refresh and eligibility checks
!scripts/refresh_amind_sources.py
!scripts/test_amind_refresh_sources.py
!scripts/package_amind_refresh.py
!scripts/verify_amind_refresh.py
!scripts/test_amind_refresh.py
!scripts/amind_refresh_atoms.py

# Paired version evaluation and reporter counterexamples
!scripts/compare_amind_agent_trials.py
!scripts/test_amind_eval_reporting.py
!scripts/grade_amind_agent_code.py

# Realistic multi-round skill-use evaluation
!scripts/run_amind_workplace_trials.py
!scripts/grade_amind_workplace_apps.py

# Frozen execution history is shipped byte-for-byte in checksum-bound archives.
# Keep live local files, logs and diagnostic aliases out of the Git file tree.
/reviews/2026-10-18-comparison/agent-runs/
/reviews/2026-10-19-workplace/runs/
/reviews/2026-10-19-workplace/product-diagnostics/evaluation/cross-engineering-review/physical/
/reviews/2026-10-19-workplace/product-diagnostics/evaluation/cross-engineering-review/v2/physical/
/reviews/2026-10-19-workplace/product-diagnostics/evaluation/cross-engineering-review/alias-directory
/reviews/2026-10-19-workplace/product-diagnostics/evaluation/cross-engineering-review/v2/alias-directory
!scripts/package_amind_review_artifacts.py
!scripts/restore_amind_review_artifacts.py
!scripts/test_restore_amind_review_artifacts.py
